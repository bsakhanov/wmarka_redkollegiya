<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
    <name>com_wmarka_redkollegiya</name>
    <author>Beibit Sakhanov</author>
    <creationDate>2026-11</creationDate>
    <copyright>(C) 2026 Beibit Sakhanov</copyright>
    <license>GNU General Public License version 3 or later; see LICENSE</license>
    <authorUrl>https://webmarka.kz</authorUrl>
    <version>0.1.1</version>
    <description>COM_WMARKA_REDKOLLEGIYA_XML_DESCRIPTION</description>
    <namespace path="src">Webmarka\Component\Redkollegiya</namespace>

    <install>
        <sql><file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file></sql>
    </install>
    <uninstall>
        <sql><file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file></sql>
    </uninstall>
    <update>
        <schemas><schemapath type="mysql">sql/updates/mysql</schemapath></schemas>
    </update>

    <media destination="com_wmarka_redkollegiya" folder="media">
        <filename>joomla.asset.json</filename>
        <folder>css</folder>
        <folder>js</folder>
    </media>

    <administration>
        <menu img="class:spell-check">COM_WMARKA_REDKOLLEGIYA</menu>
        <files folder="administrator">
            <filename>access.xml</filename>
            <filename>config.xml</filename>
            <filename>LICENSE</filename>
            <filename>NOTICE</filename>
            <folder>data</folder>
            <folder>language</folder>
            <folder>services</folder>
            <folder>sql</folder>
            <folder>src</folder>
            <folder>tmpl</folder>
        </files>
    </administration>
</extension>
